DATA_DIR=data
DB_URL=sqlite:///data/mtc.db
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
# ASR_BACKEND: mlx (Mac M1-M4) | faster (CPU: Linux/Windows/Intel Mac). Default — auto.
#ASR_BACKEND=mlx
# Empty = backend default (mlx: large-v3-turbo, faster: small). Local folder path also works.
WHISPER_MODEL=
# faster-whisper CPU threads, 0 = auto
ASR_CPU_THREADS=0
TELEGRAM_TOKEN=
HF_TOKEN=
TZ=Europe/Moscow

# --- Linux / Windows / weak PC (CPU only) ---
#ASR_BACKEND=faster
#WHISPER_MODEL=small
#OLLAMA_MODEL=qwen2.5:1.5b
#OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
