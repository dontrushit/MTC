DATA_DIR=data
DB_URL=sqlite:///data/mtc.db
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
# macOS (mlx): local mlx dir or mlx-community/whisper-large-v3-turbo
# Linux (faster-whisper): large-v3-turbo or a local CTranslate2 directory
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_BACKEND=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
TELEGRAM_TOKEN=
HF_TOKEN=
TZ=Europe/Moscow
API_URL=http://localhost:8000
# АТС МТС. Пока поля пустые, события принимаются, а файл записи не скачивается.
ATC_BASIC_USER=
ATC_BASIC_PASSWORD=
# Ссылка, куда подставить номер звонка: https://host/recordings/{call_id}
ATC_RECORDING_URL=
# Номер менеджера в нашей базе, если телефон агента ни с кем не совпал. Можно оставить пустым.
ATC_MANAGER_ID=
# Telegram-уведомления «отчёт готов». Пустой токен — функция выключена.
TELEGRAM_BOT_TOKEN=
# username бота (без @) для ссылок подключения
TELEGRAM_BOT_USERNAME=
# публичный адрес интерфейса, дописывается в конец уведомления
PUBLIC_BASE_URL=
