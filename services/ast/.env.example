# Копируйте в .env и при необходимости правьте:
#   cp .env.example .env

# UID/GID владельца каталогов на хосте (чтобы АТС могла писать в audio_records)
PUID=1000
PGID=1000

# Адрес вебхука ИИ-агента (localhost хоста из контейнера notifier)
WEBHOOK_URL=http://host.docker.internal:8000/api/v1/process-audio
